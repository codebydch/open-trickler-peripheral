[general]
# Debug logging. Off, because the trickler logs a line per pass of its control loop at
# that level, which is tens of lines a second into the journal. The final approach is
# logged pulse by pulse at INFO regardless, which is the part worth watching. Run a
# daemon by hand with --verbose when you need the rest.
verbose = False


[scale]
# See the SCALES variable in scales.py for options.
model = and
# /dev/ttyUSB0 for USB-to-serial or /dev/ttyAMA0 for serial over GPIO.
port = /dev/ttyUSB0
# Usually the max, or default, baudrate supported by your scale.
baudrate = 19200
# Scale timeout in seconds.
timeout = 0.1
# Open trickler version for legacy status mapping. Don't change unless you know what you are doing.
status_map_version = 0
# For scales that don't provide a stability flag, a number of consecutive readings to infer stability.
stable_reading_length = 5


[motor1]
trickler_pin = 18
trickler_max_pwm = 100
trickler_min_pwm = 25

[motor2]
trickler_pin = 12
trickler_max_pwm = 100
trickler_min_pwm = 25

[trickler]
# All of the weights in this section are given in GRAINS and are converted
# automatically when the scale is set to grams.
#
# Weight still to go at which trickler motor 2 (the coarse trickler) shuts off and
# motor 1 finishes the charge on its own. It must be larger than the amount both
# motors together can throw during the time the scale takes to report a change
# (roughly feed rate x scale lag), otherwise the charge blows past the target before
# the first reading moves.
fine_trickle_weight = 1.5
# Weight still to go at which continuous trickling stops for good and the pulse
# feeder takes over to finish the charge. Nothing below this is fed without weighing
# the previous pulse first, so this is the setting that decides accuracy: it must be
# comfortably bigger than what motor 1 can throw during the scale's lag.
pulse_trickle_weight = 0.5
# Longest a single pulse may run, in seconds. The pulse feeder sizes each pulse from
# what it has learned, and never asks for more than this. Measured on the bench: at 0.2
# the cap bound almost every pulse and the charge crawled; 0.4 more than tripled what a
# pulse delivers, and past that the gain flattens while a clump gets big enough to
# overshoot.
pulse_on_time = 0.4
# Seconds at the start of a pulse before the motor is actually moving powder. A pulse
# delivers rate x (on_time - this), so without it a rate measured from a short pulse reads
# low -- most of that pulse was spin-up -- and the pulse sized from it comes out too long.
# Measure it: run a batch of pulses at two lengths and solve the two mean doses for rate
# and spin-up. On a Frankford Arsenal trickler driven by a 3 V vibration motor, 120 pulses
# at 0.2 s averaged 0.0178 gn and 32 at 0.4 s averaged 0.0613 -- 3.4x the powder for twice
# the pulse, which only solves at a spin-up of 0.118 s and a steady rate of 0.217 gn/s.
# Guessing it low makes the endgame fire pulses too short to move a grain.
pulse_dead_time = 0.12
# Shortest pulse worth firing, in seconds. Together with the spin-up above this sets the
# finest dose the machine can place, and so the best accuracy it can reach. Anything at or
# below the spin-up cannot move powder at all, so keep it comfortably above that value.
pulse_min_on_time = 0.15
# How long to pause after each pulse so the powder can land, in seconds. The feeder
# then waits for the scale to report stable before weighing the result.
pulse_off_time = 0.1
# How long after a pulse before a stable scale reading is believed, in seconds. For the
# first moment after a pulse the powder is still in the air and the pan is undisturbed,
# so the scale reports the old weight as stable. Believing that reads the pulse as having
# delivered nothing, and the next one as double. Set this above the scale's reporting lag.
settle_min_time = 0.3
# Motor speed (PWM %) used while pulsing. This bypasses trickler_min_pwm, so it may
# be set lower, but never below stall_pwm.
pulse_pwm = 25
# Motor speed for pulses fired while still well short of the target, as a PWM percentage.
# Every pulse costs the same wait to weigh it whatever its size, so the way to a quicker
# charge is fewer, bigger pulses rather than a faster motor throughout -- a faster motor
# throughout would coarsen the smallest dose the machine can place, which is what sets
# its accuracy. The last pulses drop back to pulse_pwm above. Set this equal to pulse_pwm
# to use one speed for the whole final approach.
pulse_fast_pwm = 45
# Grains still to go when pulsing drops from the fast speed to the fine one.
pulse_fast_until = 0.10
# The PWM % below which the vibratory motor stalls and moves no powder at all. Found
# by walking the speed down until the powder stops moving. Nothing is ever driven
# below this.
stall_pwm = 20
# Starting guess for how much powder one second of pulsing delivers, in grains per
# second. Only used for the first pulse of the first charge: after that the feeder
# measures each pulse and learns the real figure, which is why it copes with a change
# of powder without being retuned.
pulse_rate = 0.3
# What fraction of the remaining weight each pulse aims at. Below 1.0 so that a
# mis-estimate lands under the target rather than over it, with the next pulse
# closing the gap. Lower is safer but takes more pulses.
pulse_aim = 0.85
# How long to wait for the scale to report a stable reading after a pulse, in seconds,
# before giving up and using whatever it last reported.
settle_timeout = 1.0
# Stop this far short of the target weight. On a scale reading in 0.02 gn steps this
# only ever decides one thing: whether a remainder of exactly one division is accepted
# or another pulse is fired at it. Anything below a division means the same as 0.
# At one division every charge lands one grain light, which is trickled up in seconds.
# Below it charges land on target but occasionally one grain heavy, which means dumping
# the pan. Only go lower if your scale resolves finer than the powder you are throwing.
cutoff_weight = 0.02
# Number of scale readings averaged when working out how fast powder is landing
# during the continuous phases. The loop reads far faster than the scale updates, and
# powder lands in lumps, so too short a window measures the scale's 0.02 gn step rather
# than a rate: at 4 samples (0.14 s) the in-flight estimate swung between one and three
# divisions and handed over to the pulse feeder anywhere from 0.3 to 1.1 grains short,
# which set the charge time. 12 samples spans about half a second and holds the handover
# inside a third of a grain.
rate_window = 12
# How far ahead, in seconds, to project that feed rate when deciding to slow down or
# hand over to the pulse feeder. This covers the powder already in flight plus the
# scale's own reporting lag. Set to 0 to disable the projection entirely.
lookahead_time = 0.35
# A jammed powder measure drops nothing at all: a kernel caught in the drum stops the
# handle dead, and the servo is not strong enough to shear it. So anything under this
# many grains on the scale after a dump means the measure did not cycle, rather than
# that it dropped a little. Well below any real charge, well above the scale's noise.
# Set to 0 to stop checking.
stall_drop_weight = 0.5
# How many times to work the measure before giving up. On the last failure the trickler
# stops: motors off, auto mode off, and the reason shown on the web pages -- rather than
# handing an empty pan to the tricklers, which would try to build the whole charge one
# vibration pulse at a time.
max_dump_attempts = 3
# Seconds between attempts, with the arm returned so the handle is unloaded. Backing off
# and pushing again is also what is most likely to shift a caught kernel.
dump_retry_pause = 1.0


[history]
# One row per charge, so you can see the spread rather than guess at it. Written by the
# trickler daemon and read by the web page at /app/history.
enabled = True
# Kept outside the repository so a git pull or a fresh clone can't disturb it. The
# directory is created on first use.
path = /var/lib/opentrickler/charges.csv
# Oldest rows are dropped past this, so the file can't fill the SD card.
max_rows = 500
# One row per pulse of the final approach -- motor speed, how long it ran, what it
# delivered. This is what the feed rate and the motor spin-up are fitted from, on the
# history page, instead of by hand from the journal. Written once per charge, not once per
# pulse, to spare the SD card. Defaults to pulses.csv beside the charge file.
pulses_path = /var/lib/opentrickler/pulses.csv
# About 300 charges' worth. A two-point fit needs a few dozen pulses at each length.
pulses_max_rows = 5000
# What the trickler has learned about each powder -- the feed rate at each pulse speed --
# kept here so it survives a reboot. memcache holds a live copy for the tuning page, and
# "Clear learned feed rate" there forgets both. Defaults to learned.json beside the
# charge file.
learned_path = /var/lib/opentrickler/learned.json


[profiles]
# The powder profile in use. Profiles live in [profile:Name] sections below and are
# created from the tuning page; each one carries its own learned feed rate, so switching
# powder doesn't mean re-learning. Leave blank to use the plain [trickler] values.
active =


[servo]
# This is the GPIO number of the pin, not the physical number of the pin
servo_pin = 17
# angle the server goes to when dumping powder
servo_angle = 95
# angle the servo starts at and returns to
initial_angle = 0
# maximum angle the servo can go to
max_angle = 180
# In microseconds
min_pulse_width = 500
# In microseconds
max_pulse_width = 2500


[buttons]
# GPIO pin for button1 is usually 23
button1_gpio = 23
# GPIO pin for button2 is usually 24
button2_gpio = 24


[screen]
font_path = /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf


[PID]
# Higher Kp values will:
# - decrease rise time
# - increase overshoot
# - slightly increase settling time
# - decrease steady-state error
# - degrade stability
#Kp = 10
Kp = 10
# Higher Ki values will:
# - slightly decrease rise time
# - increase overshoot
# - increase settling time
# - largely decrease steady-state error
# - degrade stability
#Ki = 2.3
Ki = 1.55
# Higher Kd values will:
# - slightly decrease rise time
# - decrease overshoot
# - decrease settling time
# - minorly affect steady-state error
# - improve stability
#Kd = 3.75
Kd = 3.75
# Enable for use with pidtuner.com
pid_tuner_mode = False


[memcache_vars]
# Variable names used for memcache.
AUTO_MODE = auto_mode
SCALE_IS_STABLE = scale_is_stable
SCALE_RESOLUTION = scale_resolution
SCALE_STATUS = scale_status
SCALE_UNIT = scale_unit
SCALE_UNITS = scale_units
SCALE_WEIGHT = scale_weight
SCALE_UNIT_MAP = scale_unit_map
SCALE_REVERSE_UNIT_MAP = scale_reverse_unit_map
SCALE_STATUS_MAP = scale_status_map
SCALE_RESOLUTION_MAP = scale_resolution_map
TARGET_WEIGHT = target_weight
TARGET_UNIT = target_unit
TRICKLER_MOTOR_SPEED = trickler_motor_speed
TRICKLER_PULSE_RATE = trickler_pulse_rate
TRICKLER_SETTINGS = trickler_settings
ACTIVE_PROFILE = active_profile
DUMP_ERROR = dump_error
TRICKLER_FAST_PULSE_RATE = trickler_fast_pulse_rate
# The web app leaves requests for the trickler daemon here; the daemon takes and acts on
# them between charges. Today: forgetting a learned feed rate.
TRICKLER_COMMAND = trickler_command
